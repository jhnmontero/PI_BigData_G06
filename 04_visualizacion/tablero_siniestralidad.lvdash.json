{
  "datasets": [
    {
      "name": "hora",
      "displayName": "Por hora",
      "queryLines": [
        "SELECT hora, con_victimas, pct_muertos FROM workspace.default.oro_hora"
      ]
    },
    {
      "name": "loc",
      "displayName": "Por localidad",
      "queryLines": [
        "SELECT localidad, con_victimas FROM workspace.default.oro_localidad WHERE localidad != 'SIN INFORMACION'"
      ]
    },
    {
      "name": "tasa",
      "displayName": "Tasa por localidad",
      "queryLines": [
        "SELECT localidad, tasa_victimas FROM workspace.default.oro_tasa_localidad WHERE localidad != 'SUMAPAZ'"
      ]
    },
    {
      "name": "cruce",
      "displayName": "Localidad y franja",
      "queryLines": [
        "SELECT localidad, SUBSTRING(franja, 3) AS franja, con_victimas FROM workspace.default.oro_localidad_franja WHERE publicable AND localidad != 'SIN INFORMACION'"
      ]
    },
    {
      "name": "clase",
      "displayName": "Por clase",
      "queryLines": [
        "SELECT clase, pct_muertos FROM workspace.default.oro_clase WHERE siniestros >= 100"
      ]
    }
  ],
